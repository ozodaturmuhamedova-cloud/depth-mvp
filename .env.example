# Секрет для подписи JWT. Обязателен всегда (в т.ч. в разработке), минимум 32 символа.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Telegram Login Widget — бот создаётся через @BotFather, домен привязывается командой /setdomain.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Telegram ID администратора (узнать через @userinfobot). Назначается при первом входе.
TELEGRAM_ADMIN_ID=


# Turso (опционально). Если не задано, используется локальный file:./data.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Имя базы, создаваемой скриптом `npm run setup:turso` (не переменная времени выполнения приложения)
TURSO_DB_NAME=ozoda-books
