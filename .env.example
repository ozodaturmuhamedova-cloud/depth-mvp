# Секрет для подписи JWT. Обязателен всегда (в т.ч. в разработке), минимум 32 символа.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Telegram OIDC Login — @BotFather → Login Widget (OIDC).
#
# В BotFather добавьте ОБА пункта:
# 1) Trusted origins: https://depth-mvp.vercel.app
# 2) Redirect URL:    https://depth-mvp.vercel.app/api/auth/telegram/callback
#
# Advanced → Signing algorithm: RS256 или ES256.
# ES256K (secp256k1) и EdDSA несовместимы со scope profile (нужен для user id).
#
# Client ID и Secret — из раздела OIDC в BotFather (не путать с username бота).
# TELEGRAM_CLIENT_ID — только цифры, без кавычек и пробелов (иначе invalid_client).
# TELEGRAM_CLIENT_SECRET — отдельный OIDC secret, НЕ токен бота (не содержит ':').
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=https://depth-mvp.vercel.app/api/auth/telegram/callback
# Базовый URL сайта (опционально, для стабильного redirect на Vercel).
APP_URL=https://depth-mvp.vercel.app
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Telegram ID администратора (узнать через @userinfobot). Назначается при первом входе.
TELEGRAM_ADMIN_ID=


# Turso (опционально). Если не задано, используется локальный file:./data.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Имя базы, создаваемой скриптом `npm run setup:turso` (не переменная времени выполнения приложения)
TURSO_DB_NAME=ozoda-books
