# Секрет для подписи JWT. Обязателен всегда (в т.ч. в разработке), минимум 32 символа.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Администратор — создаётся автоматически при первом обращении к базе.
# В системе может существовать только ОДИН пользователь с ролью admin
# (гарантируется уникальным индексом в БД, см. lib/db.ts).
ADMIN_EMAIL=admin@ozoda.app
ADMIN_PASSWORD=change-me


# Turso (опционально). Если не задано, используется локальный file:./data.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Имя базы, создаваемой скриптом `npm run setup:turso` (не переменная времени выполнения приложения)
TURSO_DB_NAME=ozoda-books
