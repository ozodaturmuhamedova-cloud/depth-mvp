# Секрет для подписи JWT. Обязателен в production.
JWT_SECRET=change-me-to-a-long-random-string

# Администратор — создаётся автоматически при первом обращении к базе.
ADMIN_EMAIL=admin@ozoda.app
ADMIN_PASSWORD=change-me

# Turso (опционально). Если не задано, используется локальный file:./data.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Имя базы, создаваемой скриптом `npm run setup:turso` (не переменная времени выполнения приложения)
TURSO_DB_NAME=ozoda-books
